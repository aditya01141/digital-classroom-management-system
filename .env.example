# Digital Classroom Management System (DCMS) - Environment Template
# Copy this file to .env.local to configure real external services.
# Leave empty to run in standalone deterministic demo mode out of the box!

# Google Gemini API Key for Live AI Learning Features (Optional)
# If omitted or empty, the application automatically uses the built-in deterministic demo engine.
VITE_GEMINI_API_KEY=

# Future Python Flask + MySQL Backend API Endpoint (Optional)
# When the Flask backend is started, point the frontend here:
VITE_BACKEND_API_URL=http://localhost:5000/api
